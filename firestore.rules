rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ランキング: 誰でも見られる。書けるのは自分の行だけ
    match /results/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // 自分のプロフィール(名前・進行状況): 自分だけ
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 問題: 誰でも読める。書けるのは管理者だけ(下の ADMIN_ID_HERE を自分のIDに書きかえる)
    match /questions/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid in ['ADMIN_ID_HERE'];
    }
  }
}
