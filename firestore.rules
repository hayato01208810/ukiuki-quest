rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ゲームマスター: 合言葉で登録された人(admins に自分の行がある人)と、下のID
    function isGM() {
      return request.auth != null && (
        request.auth.uid in ['GOWtuOOYNtTvF9GAIWu45yDKSTD2'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }
    // 合言葉で登録する: 合言葉は、このファイルではなく、Firestore の config/gm の pw に書く(あとから変えられる)
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['pw'])
                    && request.resource.data.pw == get(/databases/$(database)/documents/config/gm).data.pw;
      allow update: if false;
    }
    // ランキング: 誰でも見られる。書けるのは自分の行だけ
    match /results/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // 自分のプロフィール(名前・進行状況): 自分だけ
    match /data/users/{uid}/{doc=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // 問題・敵キャラ図鑑: 誰でも読める
    match /questions/{id} { allow read: if true; }
    match /enemies/{id} { allow read: if true; }
    // 答えの記録(分析用): 書けるのは自分の行だけ
    match /stats/{uid} {
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    // ゲームマスターは、上に書いていないものも含めて、すべて読み書きできる
    // (これからアプリに機能を足しても、ルールの書きかえは要らない)
    match /{document=**} {
      allow read, write: if isGM();
    }
  }
}
